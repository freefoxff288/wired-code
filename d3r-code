#!/bin/sh
# D3R Code — редактор кода. d3r-code [файл|папка]
D="$HOME/.local/share/d3r-code"; SYS=/usr/lib/qt6/qml/QMLTermWidget
[ -e "$SYS/qmldir" ] || { notify-send "D3R Code" "нужен qmltermwidget" 2>/dev/null; echo "D3R Code: нужен пакет qmltermwidget" >&2; exit 1; }
# модуль терминала: системный + схемы цветов D3R. Если стоит D3R Term — общий с ним, иначе свой
Q="$HOME/.local/share/d3r-term/qml"
[ -d "$Q/QMLTermWidget/color-schemes" ] || Q="$D/qml"
M="$Q/QMLTermWidget"; mkdir -p "$M"
for f in qmldir libqmltermwidget.so kb-layouts QMLTermScrollbar.qml; do ln -sfn "$SYS/$f" "$M/$f"; done
export QML_IMPORT_PATH="$Q" QML_XHR_ALLOW_FILE_READ=1 QML_XHR_ALLOW_FILE_WRITE=1
# автодополнение (C++ — clangd, Python — jedi): мост lsp.py; его родитель — этот процесс, после exec это сам редактор,
# с ним мост и завершится. clangd мост запускает только когда открыт C++-файл
LSP="${XDG_RUNTIME_DIR:-/tmp}/d3r-code/lsp-$$.port"
python3 "$D/lsp.py" "$LSP" &
exec /usr/lib/qt6/bin/qml "$D/Code.qml" -- --lsp "$LSP" "$@"
