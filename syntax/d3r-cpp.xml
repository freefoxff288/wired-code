<!-- D3R C++: стандартная подсветка C++ (KDE) + то, чего в ней нет, как в Visual Studio:
     вызовы функций, переменные, типы и пространства имён, МАКРОСЫ. Строки, комментарии, #include и ключевые
     слова остаются за ##C++ — свои правила стоят первыми, но пропускают ключевые слова (lookahead). -->
<language name="D3R C++" section="Sources" version="1" kateversion="5.79" priority="20"
          extensions="*.cpp;*.cxx;*.cc;*.c++;*.hpp;*.hxx;*.hh;*.h;*.ino;*.ipp;*.tpp" mimetype="text/x-c++src;text/x-c++hdr" license="MIT">
  <highlighting>
    <contexts>
      <context name="Main" attribute="Normal" lineEndContext="#stay">
        <!-- std::, ns:: — как тип -->
        <RegExpr attribute="Type" String="\b[A-Za-z_]\w*(?=\s*::)"/>
        <!-- имя перед ( — функция (кроме ключевых слов и типов) -->
        <RegExpr attribute="Function" String="\b(?!(?:&kw;)\b)[A-Za-z_]\w*(?=\s*(?:&lt;[^;()&lt;&gt;]*&gt;\s*)?\()"/>
        <!-- МАКРОС / КОНСТАНТА -->
        <RegExpr attribute="Macro" String="\b[A-Z][A-Z0-9_]{1,}\b(?![a-z])"/>
        <!-- типы стандартной библиотеки и свои с заглавной -->
        <RegExpr attribute="Type" String="\b(?:&std;)\b|\b[A-Z]\w*[a-z]\w*\b"/>
        <!-- остальные имена — переменные -->
        <RegExpr attribute="Variable" String="\b(?!(?:&kw;)\b)[A-Za-z_]\w*"/>
        <IncludeRules context="##C++"/>
      </context>
    </contexts>
    <itemDatas>
      <itemData name="Normal" defStyleNum="dsNormal"/>
      <itemData name="Function" defStyleNum="dsFunction"/>
      <itemData name="Variable" defStyleNum="dsVariable"/>
      <itemData name="Type" defStyleNum="dsBuiltIn"/>
      <itemData name="Macro" defStyleNum="dsConstant"/>
    </itemDatas>
  </highlighting>
  <general>
    <keywords casesensitive="1"/>
  </general>
</language>
